# Render production configuration. Replace every placeholder in the dashboard.
TRUST_JUGGLER_FRONTEND_ORIGIN=https://your-app.vercel.app
TRUST_JUGGLER_TOKEN_SECRET=replace-with-a-long-random-secret
TRUST_JUGGLER_ADMIN_USERNAME=replace-with-admin-username
TRUST_JUGGLER_ADMIN_PASSWORD=replace-with-a-long-random-password

# Use this path only when a Render persistent disk is mounted at /var/data.
TRUST_JUGGLER_DB=/var/data/trust_juggler.db

# Optional. Without this key, escalations use the deterministic reason-vector fallback.
# ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# REASON_VECTOR_MODEL=claude-haiku-5-5
