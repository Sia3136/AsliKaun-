# AsliKaun Authentication & Deployment Configuration



# JWT Token Secret (Change in production)
ASLIKAUN_TOKEN_SECRET="development-secret-aslikaun-2026-replace-for-prod"

# Admin Seed Credentials
ASLIKAUN_ADMIN_USERNAME="admin"
ASLIKAUN_ADMIN_PASSWORD="admin-aslikaun-2026"

# Groq Free LLM API Key (for explainability)
GROQ_API_KEY=""
REASON_VECTOR_GROQ_MODEL="qwen/qwen3.8-27b"

# Optional Production Configuration
ASLIKAUN_FRONTEND_ORIGIN=""
DATABASE_URL="postgresql://appuser:SET_LOCALLY@localhost:5432/appdb"
REDIS_URL="redis://localhost:6379"
ASLIKAUN_DB=""
ASLIKAUN_ASYNC_INGEST="true"
ASLIKAUN_INGEST_STREAM="aslikaun:telemetry"
ASLIKAUN_INGEST_CONSUMER_GROUP="aslikaun-workers"
ASLIKAUN_REQUIRE_DEVICE_SIGNATURE="false"
ASLIKAUN_TENANT_ID="default"
ASLIKAUN_TENANT_NAME="AsliKaun Core"
POSTGRES_USER="appuser"
POSTGRES_PASSWORD="SET_LOCALLY"
POSTGRES_DB="appdb"
REDIS_PORT="6379"
