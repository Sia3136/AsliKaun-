# AsliKaun / Trust Juggler Authentication Configuration

# Google OAuth 2.0 Credentials
# Obtain these from https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Web Application)
# 2. Add Authorized redirect URI: http://localhost:8000/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/v1/auth/google/callback"

# JWT Token Secret (Change in production)
TRUST_JUGGLER_TOKEN_SECRET="development-secret-trustmesh-2026-replace-for-prod"

# Optional Initial Admin Seed Credentials
TRUST_JUGGLER_ADMIN_USERNAME="admin"
TRUST_JUGGLER_ADMIN_PASSWORD="admin-trustjuggler-2026"
