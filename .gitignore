# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Data directory (datasets, trajectories, extracted zips, raw logs)
data/

# Archives and compressed files
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Large dataset formats
*.geojson
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.csv

# Model weights and binaries — EXCEPT the small production inference
# weights RiderModelBundle actually loads at runtime (each <100KB; see
# ml/README.md). Those are committed deliberately: without them, a
# fresh deploy (Render builds from a git clone, no separate asset
# step) silently falls back to the heuristic scorer forever, never the
# real trained models. Large experimental/training checkpoints stay
# ignored via the blanket *.pt below. (Negations MUST come after the
# pattern they override — git applies .gitignore rules in file order.)
*.weights
*.pt
*.pth
*.onnx
*.bin
!ml/weights/touch_triplet_encoder.pt
!ml/weights/motion_triplet_encoder.pt
!ml/weights/gps_encoder.pt

node_modules/
dist/
!frontend/mobile-app/dist/
!frontend/mobile-app/dist/**
*.log
.env*
!.env.example
meridian-assets/

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# SQLite Databases
*.db
*.sqlite
*.sqlite3
