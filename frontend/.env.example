# Frontend API configuration
# Leave empty during local development: both Vite servers proxy /v1 and /health
# to the FastAPI service at http://127.0.0.1:8000.
VITE_ASLIKAUN_API_URL=""

# Driver demo identity used by frontend/mobile-app.
# Never use the demo token outside local development.
VITE_ASLIKAUN_DRIVER_ID="rider-001"
VITE_ASLIKAUN_DRIVER_TOKEN="demo-driver-token-2026"

# Optional legacy aliases supported by the client.
# VITE_TRUSTMESH_API_URL=""
# VITE_TRUSTMESH_DRIVER_ID=""
# VITE_TRUSTMESH_DRIVER_TOKEN=""

# Optional AI Studio/runtime values used by the landing app.
# GEMINI_API_KEY=""
# APP_URL="http://localhost:3000"
